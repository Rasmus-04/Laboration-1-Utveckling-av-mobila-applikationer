<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Laboration_1_Rasmus_Serrestam.MainPage"
             Title="Laboration 1 Rasmus Serrestam">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Label
            Text="Marketplace"
            FontSize="28"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <CollectionView ItemsSource="{Binding Items}">

            <CollectionView.EmptyView>
                <Label
                    Text="Inga produkter hittades."
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border
                        Padding="15"
                        Margin="0,5"
                        Stroke="LightGray"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10">

                        <VerticalStackLayout Spacing="5">

                            <Label
                                Text="{Binding Title}"
                                FontSize="18"
                                FontAttributes="Bold" />

                            <Label
                                Text="{Binding Price, StringFormat='{0:N2} kr'}"
                                FontSize="16" />

                            <Label
                                Text="{Binding Condition.Name}"
                                FontSize="14"
                                TextColor="Gray" />

                        </VerticalStackLayout>

                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </VerticalStackLayout>

</ContentPage>
