<ContentPage
    x:Class="Laboration_1_Rasmus_Serrestam.Views.ItemDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Produkt information">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="15">

            <Label
                Text="{Binding Item.Title}"
                FontSize="28"
                FontAttributes="Bold" />

            <Label
                Text="{Binding Item.Price, StringFormat='{0:N2} kr'}"
                FontSize="22" />

            <Label
                Text="{Binding Item.Condition.Name}"
                FontSize="18"
                TextColor="Gray" />

            <Label
                Text="Beskrivning"
                FontSize="20"
                FontAttributes="Bold" />

            <Label
                Text="{Binding Item.Description}"
                FontSize="16" />

            <Label
                Text="Säljarens e-post"
                FontSize="20"
                FontAttributes="Bold" />

            <Label
                Text="{Binding Item.SellerEmail}"
                FontSize="16" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>